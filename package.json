{
  "name": "cuez-qa-part-3-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Part 3 of the SupportLabs x Cuez QA assessment: Playwright tests for Restful Booker Platform",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pretest": "playwright install chromium",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
